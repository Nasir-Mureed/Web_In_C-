@model List<Car>

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<h1>Booked cars</h1>
@if (Model.Count > 0)
{
    <table class="table table-striped table-hover ">
        <thead class="bg-dark text-light">
        <th>ID</th>
        <th>Name</th>
        <th>Price Per Day</th>
        <th>status</th>
        </thead>
    
        @foreach (var c in Model)
        {
            <tr >
                <td >@c.Id  </td>
                <td> @c.Name</td>
                <td>@c.PricePerDay</td>
           
                <td>  <div class="badge bg-warning text-dark">Booked</div></td>
            
            </tr>
        }

    </table> 
}
else
{
    <div class="container-fluid justify-content-center">
        
        <h2 class="text-danger">No Car is booked </h2>
    </div>
}


</body>
</html>