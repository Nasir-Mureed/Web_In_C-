
@model List<Car>

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<h1>Availables cars</h1>


<div class="container my-4">     
    <div class="row g-4">         
        @foreach (var c in Model)         
        {                          
            <div class="col-md-4">
                <div class="card h-100 p-4 shadow-sm">
                    <div class="card-body d-flex flex-column"> 
                        <h2 class="card-title h4">@c.Name</h2> 
                        <p class="card-text text-muted">Price Per Day: @c.PricePerDay</p>
                        
                        <form action="/Car/BookCar" method="post" class="mt-auto">                     
                            <input type="hidden" name="id" value="@c.Id"/>                     
                            <button class="btn btn-primary w-100" type="submit">Book Car</button>                 
                        </form> 
                    </div>
                </div>             
            </div>                      
        }     
    </div> 
</div>

</body>
</html>